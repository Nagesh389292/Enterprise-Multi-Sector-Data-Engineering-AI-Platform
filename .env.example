# =========================================================
# APPLICATION
# =========================================================
ENVIRONMENT=development
USE_LOCAL_LLM_FALLBACK=true

# =========================================================
# DATABASE & CACHE
# =========================================================
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0

# =========================================================
# GEMINI AI & OXALPHA (CLOUD LLM)
# =========================================================
# Obtain key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
OXALPHA_API_KEY=

# =========================================================
# HUGGING FACE (NLP & EMBEDDINGS)
# =========================================================
# Obtain token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# =========================================================
# FINANCIAL DATA (ALPHA VANTAGE)
# =========================================================
# Obtain key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# =========================================================
# INDIA OPEN DATA (DATA.GOV.IN)
# =========================================================
DATA_GOV_API_KEY=

# =========================================================
# APACHE SUPERSET ENTERPRISE BI (DOCKER / REST API)
# =========================================================
SUPERSET_URL=http://localhost:8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# =========================================================
# GOOGLE CLOUD PLATFORM
# =========================================================
GCP_PROJECT_ID=enterprise-data-ai-platform
GOOGLE_APPLICATION_CREDENTIALS=



# =========================================================
# DATABRICKS CLOUD DATA ENGINEERING
# =========================================================
# Workspace URL (non-secret — safe to commit)
DATABRICKS_HOST=https://dbc-988b03b0-c952.cloud.databricks.com
# Workspace and Warehouse IDs (non-secret — safe to commit)
DATABRICKS_WORKSPACE_ID=7474646556233194
DATABRICKS_WAREHOUSE_ID=1f1403d78bfa0404
# Auth mode: use 'pat' for Personal Access Token (server-side automation)
DATABRICKS_AUTH_MODE=pat
# Unity Catalog target (adjust if your workspace uses hive_metastore)
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=enterprise_gold
# DATABRICKS_TOKEN=<your_personal_access_token>
# ^^^ NEVER commit your token. Add it only to your local .env file (gitignored).

